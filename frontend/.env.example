# --- Backend API URL ---
# Per lo sviluppo locale, punta al server backend locale.
# Esempio locale:    VITE_API_URL=http://localhost:5001
# Esempio produzione: VITE_API_URL=/api  (quando frontend e backend sono co-deployati)
VITE_API_URL=http://localhost:5001
