# ============================================================
# TRADER VISION — BACKEND ENVIRONMENT VARIABLES TEMPLATE
# ✅  Questo file è SICURO da caricare su Git. Non contiene segreti reali.
# ✅  Copia questo file in `.env` e inserisci i tuoi valori reali.
# ============================================================

# --- Server ---
PORT=5001
NODE_ENV=development

# --- Database ---
# URI completa di connessione a MongoDB Atlas.
# Esempio: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0
MONGODB_URI=inserisci_qui_il_tuo_mongodb_uri

# --- Authentication ---
# Chiave segreta per la firma dei JWT. Deve essere lunga, casuale e complessa (min. 32 caratteri).
# Generazione suggerita: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=inserisci_qui_il_tuo_jwt_secret

# --- Master Admin User ---
# L'email che riceverà automaticamente i privilegi di master al momento della registrazione.
MASTER_EMAIL=la_tua_email_di_amministratore@example.com

# --- CORS (Production Origins) ---
# L'origine del tuo frontend su Vercel (es. https://trader-vision.vercel.app).
# Puoi aggiungere anche il dominio personalizzato se ne hai uno.
CORS_ORIGIN_1=https://il-tuo-progetto.vercel.app
CORS_ORIGIN_2=https://www.il-tuo-dominio-personalizzato.com

# --- Email / Newsletter ---
# Configurazione SMTP per l'invio delle newsletter (es. Resend, SendGrid, Gmail SMTP).
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=465
EMAIL_USER=resend
EMAIL_PASS=inserisci_qui_la_tua_password_smtp
EMAIL_FROM=La Tua App <newsletter@il-tuo-dominio.com>

# --- External API Keys ---
FINNHUB_API_KEY=inserisci_qui_la_tua_finnhub_api_key
ALPHA_VANTAGE_API_KEY=inserisci_qui_la_tua_alpha_vantage_api_key
GEMINI_API_KEY=inserisci_qui_la_tua_gemini_api_key
FRED_API_KEY=inserisci_qui_la_tua_fred_api_key
